function vslice_addevent_FocusCamera(v:Dynamic, t:Float) {
	if (v == null)
		return;

	switch (v) {
		case -1:
			return;

		case 0:
			PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
				if (PlayState.instance.stage.player != null)
					PlayState.instance.camFollow.setPosition(
						PlayState.instance.stage.player.getGraphicMidpoint().x + PlayState.instance.stage.player.cameraOffsets[0],
						PlayState.instance.stage.player.getGraphicMidpoint().y + PlayState.instance.stage.player.cameraOffsets[1]
					);
			});
			return;
		case 1:
			PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
				if (PlayState.instance.stage.opponent != null)
					PlayState.instance.camFollow.setPosition(
						PlayState.instance.stage.opponent.getGraphicMidpoint().x + PlayState.instance.stage.opponent.cameraOffsets[0],
						PlayState.instance.stage.opponent.getGraphicMidpoint().y + PlayState.instance.stage.opponent.cameraOffsets[1]
					);
			});
			return;
		case 2:
			PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
				if (PlayState.instance.stage.damsel != null)
					PlayState.instance.camFollow.setPosition(
						PlayState.instance.stage.damsel.getGraphicMidpoint().x + PlayState.instance.stage.damsel.cameraOffsets[0],
						PlayState.instance.stage.damsel.getGraphicMidpoint().y + PlayState.instance.stage.damsel.cameraOffsets[1]
						);
			});
			return;
	}

	var char:Int = 0;

	var xOffset:Float = 0;
	var yOffset:Float = 0;

	var duration:Float = 0;

	var ease:String = '';
	var easeDir:String = '';
	
	if (v.char != null) char = v.char;

	if (v.x != null) xOffset += v.x;
	if (v.t != null) xOffset += v.t;

	if (v.duration != null) duration += v.duration;

	if (v.ease != null) ease = v.ease;
	if (v.easeDir != null) easeDir = v.easeDir;

	var targetX = xOffset;
	var targetY = yOffset;

	switch (char) {
		case -1:
			PlayState.instance.camFollow.setPosition(xOffset, yOffset);

		case 0:
			if (PlayState.instance.stage.player != null) {
				targetX += PlayState.instance.stage.player.getGraphicMidpoint().x;
				targetY += PlayState.instance.stage.player.getGraphicMidpoint().y;

				targetX += PlayState.instance.stage.player.cameraOffsets[0];
				targetY += PlayState.instance.stage.player.cameraOffsets[1];
			}

		case 1:
			if (PlayState.instance.stage.opponent != null) {
				targetX += PlayState.instance.stage.opponent.getGraphicMidpoint().x;
				targetY += PlayState.instance.stage.opponent.getGraphicMidpoint().y;

				targetX += PlayState.instance.stage.opponent.cameraOffsets[0];
				targetY += PlayState.instance.stage.opponent.cameraOffsets[1];
			}

		case 2:
			if (PlayState.instance.stage.damsel != null) {
				targetX += PlayState.instance.stage.damsel.getGraphicMidpoint().x;
				targetY += PlayState.instance.stage.damsel.getGraphicMidpoint().y;

				targetX += PlayState.instance.stage.damsel.cameraOffsets[0];
				targetY += PlayState.instance.stage.damsel.cameraOffsets[1];
			}
	}

	if (v.ease == null)
		ease = 'CLASSIC';

	switch (ease) {
		case 'CLASSIC':
			PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
				PlayState.instance.camFollow.setPosition(targetX, targetY);
			});
		case 'INSTANT':
			PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
				PlayState.instance.camFollow.setPosition(targetX, targetY);
				PlayState.instance.camGame.focusOn(PlayState.instance.camFollow.getPosition());
			});
		default:
			var easeFunctionName = '' + ease + easeDir;

			var easeFunction:Null<Float->Float> = Reflect.field(FlxEase, easeFunctionName);
			if (easeFunction == null) {
				// trace('Invalid ease function: ' + easeFunctionName);

				PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
					FlxTween.tween(PlayState.instance.camFollow, {
						x: targetX,
						y: targetY,
					}, duration);
				});
			} else 
				PlayState.instance.addEvent(t / Constants.MS_PER_SEC, function() {
					FlxTween.tween(PlayState.instance.camFollow, {
						x: targetX,
						y: targetY,
					}, duration, {
						ease: easeFunction
					});
				});
		
	}
}
